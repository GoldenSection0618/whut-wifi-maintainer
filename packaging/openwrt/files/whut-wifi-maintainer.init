#!/bin/sh /etc/rc.common
START=98
USE_PROCD=1

start_service() {
	local config=/etc/whut-wifi-maintainer/config.toml
	/usr/bin/whut-wifi-maintainer --config "$config" --check-config --non-interactive || return 1
	procd_open_instance
	procd_set_param command /usr/bin/whut-wifi-maintainer --config "$config" --non-interactive
	# Stop after three rapid failures (e.g. explicitly rejected credentials).
	procd_set_param respawn 3600 5 3
	procd_set_param file "$config"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
